APP_NAME=Vintage-Aware Wind Forecast API
APP_ENV=development
DATABASE_URL=sqlite:///./wind_forecasts.db
CORS_ORIGINS=["http://localhost:5173"]
FORECAST_PROVIDER=mock
WEATHER_PROVIDER=mock
AGENT_PROVIDER=mock
# Web mode=integrated invokes M1+M2 regardless of the legacy provider flags.
# Keep off for offline verification. On permits a paid external LLM request.
INTEGRATED_LLM=off
# Download missing historical forecasts from Open-Meteo; true uses cache only.
INTEGRATED_OFFLINE=false
# Optional absolute path; default is <repository>/outputs/web.
# INTEGRATED_OUTPUT_DIR=
